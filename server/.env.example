# Use MongoDB Atlas or a local replica set; transactions keep project and lead creation atomic.
# For a persistent local replica set with no setup, run npm run demo from the root.
# Keep real credentials in server/.env, which is ignored by Git.
MONGO_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0
DB_NAME=pa3
USERS_COLLECTION=Users
PORT=9000
CLIENT_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# To reuse PA2 users, set DB_NAME to that database and USERS_COLLECTION to its users collection.
