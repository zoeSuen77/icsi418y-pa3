{
  "name": "icsi418y-pa3",
  "version": "2.0.0",
  "private": true,
  "description": "ICSI 418Y PA3 \u2014 Projects and project memberships with React, Express, and MongoDB",
  "workspaces": [
    "client",
    "server"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently --kill-others -n server,client \"npm run dev --workspace server\" \"npm run dev --workspace client\"",
    "demo": "node scripts/demo.cjs",
    "build": "npm run build --workspace client",
    "start": "npm start --workspace server",
    "test": "node --test tests/*.test.cjs",
    "test:ui": "playwright test",
    "db:users": "node scripts/show-users.cjs",
    "demo:seed": "node scripts/seed-demo.cjs",
    "db:inspect": "node scripts/inspect-db.cjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "concurrently": "^9.2.1",
    "mongodb-memory-server": "^11.3.0"
  },
  "config": {
    "mongodbMemoryServer": {
      "version": "7.0.14",
      "downloadDir": "./.cache/mongodb-binaries",
      "disablePostinstall": true
    }
  }
}
